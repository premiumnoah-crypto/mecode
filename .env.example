# ローカル実行用の環境変数サンプル。
# 本番(GitHub Actions)では GitHub Secrets に同名で登録してください。
# 使うときは `.env` にコピーして値を埋め、`export $(cat .env | xargs)` 等で読み込む。

# --- X(Twitter) API v2 ---  https://developer.x.com/
X_BEARER_TOKEN=

# --- Claude(任意の定性サマリー) ---
ANTHROPIC_API_KEY=

# --- メール送信(Gmail例) ---
# Gmailは「2段階認証 + アプリパスワード」を SMTP_PASS に使う
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_address@gmail.com
SMTP_PASS=your_app_password
REPORT_TO=platinumnoah@gmail.com

# --- Discord 通知(任意) ---  チャンネル設定→連携サービス→Webhook で取得
DISCORD_WEBHOOK_URL=

# --- LINE 通知(任意) ---  ※旧LINE Notifyは終了。Messaging APIを使用
# LINE Developers でMessaging APIチャネルを作成しアクセストークンを発行、
# LINE_TO は送信先のユーザーID/グループID
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# Reddit / Google Trends はキー不要（無料の公開エンドポイントを使用）
